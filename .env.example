# ── Database (required in production on Vercel) ──────────────────────────────
# Neon Postgres connection string (https://neon.tech — free tier works).
# In Vercel: Project → Settings → Environment Variables → DATABASE_URL
# Use Neon's POOLED connection string (host contains "-pooler") for serverless.
# Example:
# DATABASE_URL=postgresql://user:password@ep-cool-name-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── NVIDIA NIM API (optional overrides) ──────────────────────────────────────
# API keys are managed at runtime in the /admin panel (stored in the database).
# Only override the base URL if you proxy the NVIDIA API somewhere else.
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Website previews (optional) ──────────────────────────────────────────────
# Hosted previews (/p/<id>) are stored in the database and auto-delete this
# long after creation. Default: 300000 (5 minutes).
# PREVIEW_TTL_MS=300000
